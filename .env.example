# ===== Aplicação =====
PORT=3000
APP_URL=http://localhost:3000
TZ=America/Sao_Paulo
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo

# ===== PostgreSQL =====
DATABASE_URL=postgres://vrsalas:vrsalas@localhost:5432/vrsalas

# ===== Administrador inicial (criado se não existir nenhum admin) =====
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@vrsoft.com.br
ADMIN_PASSWORD=Admin@123

# ===== E-mail (Google Workspace SMTP) =====
# Use uma "senha de app" da conta remetente ou um relay SMTP do Workspace.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VR Salas <salas@vrsoft.com.br>"

# ===== Google OAuth / Agenda =====
# Console Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Só permite login Google de contas deste domínio
GOOGLE_ALLOWED_DOMAIN=vrsoft.com.br
# true = cria automaticamente o usuário no primeiro login Google; false = só usuários já cadastrados pelo admin
GOOGLE_AUTO_PROVISION=true
